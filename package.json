{
  "name": "netplan",
  "private": true,
  "version": "0.1.0",
  "description": "YAML → IP-plan spreadsheet + D2 topology (static site)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "gen:types": "tsx scripts/gen-types.ts",
    "gen:docs": "tsx scripts/gen-schema-docs.ts",
    "check:schema": "tsx scripts/gen-schema-docs.ts --check && tsx scripts/gen-types.ts --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@terrastruct/d2": "^0.1.33",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "codemirror": "^6.0.2",
    "lz-string": "^1.5.0",
    "marked": "^18.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
